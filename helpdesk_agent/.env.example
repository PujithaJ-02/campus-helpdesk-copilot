# Copy to helpdesk_agent/.env and fill in. Never commit .env.

# Gemini and embeddings through Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Chat models: some newer Gemini models are only served from the global endpoint.
GOOGLE_CLOUD_LOCATION=global
HELPDESK_MODEL=gemini-3.5-flash
# The model keeps its own location even when Agent Engine sets GOOGLE_CLOUD_LOCATION to the deploy region.
HELPDESK_MODEL_LOCATION=global
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Embeddings stay regional: the global endpoint added ~10s after idle in testing.
EMBED_LOCATION=us-central1

# ServiceNow personal developer instance
SN_INSTANCE=dev123456
SN_USER=admin
SN_PASSWORD=change-me

# true = no writes to ServiceNow. Flip to false only when you want real tickets.
DRY_RUN=true

# Role used when the caller does not set one: requester (safe default) or it_staff.
# Set it_staff locally to try triage in `adk web`.
DEFAULT_ROLE=requester
